<section class="sec" id="beneficiarios" style="--pt:4%;--pr-md:24px;--pb:5%;--pl-md:24px;--bgi:linear-gradient(216deg, rgba(255,255,255,0) 0%,#ffffff 100%)"><div class="row items-center justify-center" style="--row-max:1310.4px;--row-gap:4%"><div class="col" data-anim="fadeInRight" data-anim-dur="1.6" style="--w:100%;--sl:1.92%;--sr:1.92%;--mt:20px;--mb:39px;--w-md:100%;--sl-md:1.92%;--sr-md:1.92%;--w-sm:100%;--sl-sm:1.92%;--sr-sm:1.92%"><div class="col__in jc-center"><div class="ttl ttl--center" style="--c:#025878;--mt-sm:10px;--mb-sm:20px;--ml-sm:0px;--mr-sm:0px"><h3 class="ttl__h">CUENTAS CON BENEFICIARIOS</h3>
