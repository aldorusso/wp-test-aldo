---
// Bandera circular para el selector de idioma (dibujo propio, 20×20).
// El recorte circular se hace con CSS (sin ids), así funciona aunque haya varias en la página.
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
---
{lang === 'en' ? (
  <svg class="flag" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <rect width="20" height="20" fill="#b22234" />
    {[1, 3, 5, 7, 9, 11].map((i) => <rect y={i * 1.54} width="20" height="1.54" fill="#fff" />)}
    <rect width="9" height="10.8" fill="#3c3b6e" />
    {[[2, 2], [5, 2], [3.5, 4], [2, 6], [5, 6], [3.5, 8]].map(([x, y]) => <circle cx={x} cy={y} r="0.55" fill="#fff" />)}
  </svg>
) : (
  <svg class="flag" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <rect width="20" height="20" fill="#aa151b" />
    <rect y="5" width="20" height="10" fill="#f1bf00" />
  </svg>
)}

<style>
  .flag { display: block; border-radius: 50%; overflow: hidden; clip-path: circle(50%); }
</style>
