---
// Icono SVG en línea desde src/icons (Font Awesome Free, CC BY 4.0).
interface Props { name: string; class?: string; label?: string }
const { name, class: cls = '', label } = Astro.props;
const files = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = files[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icono no encontrado: ${name}`);
const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"';
const svg = raw.replace(/<!--[\s\S]*?-->/g, '').replace('<svg ', `<svg class="${cls}" ${a11y} `);
---
<Fragment set:html={svg} />
